# Server Configuration
PORT=3000
NODE_ENV=development

# Admin Security
ADMIN_PIN=1234

# Midtrans Payment Gateway (Core API QRIS)
# Ambil Server Key dari: https://dashboard.sandbox.midtrans.com/settings/access-keys
MIDTRANS_SERVER_KEY=SB-Mid-server-your_key_here
MIDTRANS_ENV=sandbox
MIDTRANS_IS_PRODUCTION=false

# Storage Lokal
OUTPUT_FOLDER=./data/photos
DATABASE_PATH=./data/photobooth.db

# Cloudflare R2 (Soft File Storage - S3 Compatible)
# Ambil dari Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://pub-your_public_id.r2.dev

# Web Gallery Publik (Vercel)
GALLERY_BASE_URL=https://your-booth.vercel.app
