# Server Configuration
PORT=3000
NODE_ENV=development

# Admin Security
ADMIN_PIN=1234

# Midtrans Payment Gateway (Core API QRIS)
# Ambil Server Key dari: https://dashboard.sandbox.midtrans.com/settings/access-keys
MIDTRANS_SERVER_KEY=SB-Mid-server-your_key_here
MIDTRANS_ENV=sandbox
MIDTRANS_IS_PRODUCTION=false

# Storage
OUTPUT_FOLDER=./data/photos
DATABASE_PATH=./data/photobooth.db

